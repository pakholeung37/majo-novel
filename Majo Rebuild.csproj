<Project Sdk="Godot.NET.Sdk/4.7.2">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <EnableDynamicLoading>true</EnableDynamicLoading>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <AnalysisLevel>latest-Recommended</AnalysisLevel>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <NoWarn>$(NoWarn);SYSLIB1220;CS0618</NoWarn>
    <DefaultItemExcludes>$(DefaultItemExcludes);tests/Majo.Runtime.UnitTests/**;tests/Majo.CommandGenerator.Tests/**;tests/fixtures/**;**/bin/**;**/obj/**</DefaultItemExcludes>
  </PropertyGroup>

  <Import Project="addons\YarnSpinner-Godot\YarnSpinner-Godot.props" />
  <Import Project="addons\majo_runtime\MajoRuntime.props" />
</Project>
