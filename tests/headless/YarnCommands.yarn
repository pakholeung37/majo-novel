<<camera stage:illustration center:37.384,74.816 zoom:3 rotation:10 via:cut>>
<<beat end wait:false>>
<<camera move stage:illustration center:44.438,71.950 duration:0.4 ease:back-out>>
<<beat begin>>
<<screen show illustration via:cut>>
<<beat end wait:true>>
