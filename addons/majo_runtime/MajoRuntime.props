<Project>
  <ItemGroup>
    <Compile Remove="$(MSBuildThisFileDirectory)**/*.cs" />
    <Compile Remove="$(MSBuildThisFileDirectory)../YarnSpinner-Godot/**/*.cs" />
    <Compile Include="$(MSBuildThisFileDirectory)Build/YarnHostRegistration.cs" />
    <Compile Include="$(MSBuildThisFileDirectory)Build/MajoAssemblyLoader.cs" Condition="'$(MajoGodotLibrary)' != 'true'" />
    <ProjectReference Include="$(MSBuildThisFileDirectory)Assemblies/Majo.Runtime.Godot/Majo.Runtime.Godot.csproj" />
    <ProjectReference Include="$(MSBuildThisFileDirectory)SourceGenerators/Majo.CommandGenerator/Majo.CommandGenerator.csproj"
                      ReferenceOutputAssembly="false" OutputItemType="Analyzer" />
  </ItemGroup>
</Project>
