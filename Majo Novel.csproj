<Project Sdk="Godot.NET.Sdk/4.7.2">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <EnableDynamicLoading>true</EnableDynamicLoading>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <AnalysisLevel>latest-Recommended</AnalysisLevel>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <EmitCompilerGeneratedFiles>true</EmitCompilerGeneratedFiles>
    <CompilerGeneratedFilesOutputPath>$(BaseIntermediateOutputPath)generated</CompilerGeneratedFilesOutputPath>
    <NoWarn>$(NoWarn);SYSLIB1220;CS0618;CS1998</NoWarn>
    <DefaultItemExcludes>$(DefaultItemExcludes);build/**;tools/**;tests/*Tests/**;tests/fixtures/**;**/bin/**;**/obj/**</DefaultItemExcludes>
  </PropertyGroup>

  <Import Project="addons\YarnSpinner-Godot\YarnSpinner-Godot.props" />
  <Import Project="addons\majo_runtime\MajoRuntime.props" />
  <ItemGroup>
    <Compile Remove="demos/**/*.cs;tests/**/*.cs" />
    <ProjectReference Include="demos/Majo.Demos.csproj" />
    <ProjectReference Include="tests/Majo.Runtime.Headless/Majo.Runtime.Headless.csproj" Condition="'$(Configuration)' == 'Debug'" />
  </ItemGroup>
</Project>
