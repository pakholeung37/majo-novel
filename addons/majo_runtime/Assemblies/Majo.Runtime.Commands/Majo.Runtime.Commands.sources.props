    <MajoCommandSource Include="$(MSBuildThisFileDirectory)../../Runtime/Dialogue/Commands/RuntimeCommandException.cs" />
    <MajoCommandSource Include="$(MSBuildThisFileDirectory)../../Runtime/Dialogue/Commands/RuntimeCommandActivity.cs" />
